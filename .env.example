# Azure Storage Configuration (REST API)

# Default connection to use
AZURE_STORAGE_DEFAULT=azure

# Primary Azure Storage Account (using account key)
AZURE_STORAGE_ACCOUNT_NAME=your_storage_account_name
AZURE_STORAGE_ACCOUNT_KEY=your_storage_account_key
AZURE_STORAGE_CONTAINER=your_default_container
AZURE_STORAGE_ENDPOINT=https://your_storage_account_name.blob.core.windows.net/
AZURE_STORAGE_URL=https://your_storage_account_name.blob.core.windows.net/
AZURE_STORAGE_VISIBILITY=public
AZURE_STORAGE_TIMEOUT=300
AZURE_STORAGE_VERIFY_SSL=true

# Alternative: SAS Token Authentication
# AZURE_STORAGE_SAS_ACCOUNT_NAME=your_storage_account_name
# AZURE_STORAGE_SAS_TOKEN=your_sas_token
# AZURE_STORAGE_SAS_CONTAINER=your_default_container
# AZURE_STORAGE_SAS_ENDPOINT=https://your_storage_account_name.blob.core.windows.net/
# AZURE_STORAGE_SAS_URL=https://your_storage_account_name.blob.core.windows.net/
# AZURE_STORAGE_SAS_VISIBILITY=public
# AZURE_STORAGE_SAS_TIMEOUT=300
# AZURE_STORAGE_SAS_VERIFY_SSL=true

# Blob Storage Settings
AZURE_BLOB_CHUNK_SIZE=4194304  # 4MB
AZURE_BLOB_MAX_RETRY_ATTEMPTS=3
AZURE_BLOB_RETRY_DELAY=1000    # milliseconds
AZURE_BLOB_TIMEOUT=300         # seconds
AZURE_BLOB_CONCURRENT_UPLOADS=5

# Content Type Detection
AZURE_AUTO_DETECT_CONTENT_TYPE=true

# Security Settings
AZURE_ENCRYPT_AT_REST=true
AZURE_REQUIRE_HTTPS=true
AZURE_ALLOWED_FILE_TYPES="jpg,jpeg,png,gif,pdf,doc,docx,txt,zip"
AZURE_MAX_FILE_SIZE=104857600  # 100MB

# CDN Settings (optional)
AZURE_CDN_ENABLED=false
# AZURE_CDN_ENDPOINT=your_cdn_endpoint
# AZURE_CDN_PROFILE=your_cdn_profile
# AZURE_CDN_RESOURCE_GROUP=your_resource_group

# Logging Settings
AZURE_STORAGE_LOGGING_ENABLED=true
AZURE_STORAGE_LOG_CHANNEL=single
AZURE_STORAGE_LOG_LEVEL=info
AZURE_STORAGE_LOG_REQUESTS=false
AZURE_STORAGE_LOG_RESPONSES=false

# Cache Settings
AZURE_STORAGE_CACHE_ENABLED=true
AZURE_STORAGE_CACHE_TTL=3600   # 1 hour
AZURE_STORAGE_CACHE_PREFIX=azure_storage
# AZURE_STORAGE_CACHE_STORE=    # uses default if empty

# Queue Settings (for background processing)
AZURE_STORAGE_QUEUE_ENABLED=false
AZURE_STORAGE_QUEUE_CONNECTION=default
AZURE_STORAGE_QUEUE_NAME=azure-storage
AZURE_STORAGE_LARGE_FILE_THRESHOLD=52428800  # 50MB
